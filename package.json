  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/api/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:cov": "vitest run --project unit --coverage",
    "test:debug": "vitest --project unit --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --project e2e",
    "prebuild": "ts-node scripts/make-index.ts",
    "migrate:clickhouse": "ts-node -r tsconfig-paths/register scripts/migrate-clickhouse.ts up",
    "migrate:clickhouse:status": "ts-node -r tsconfig-paths/register scripts/migrate-clickhouse.ts status",
    "release": "./scripts/release.sh"
  },
